<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Listshop" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/third_blue</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurface">@color/white</item>

        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>


        <item name="thumbIcon">@drawable/ic_just_back</item>


    </style>
    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/MyDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/MyDialogButtonStyle</item>
    </style>

    <style name="MyDialogButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/blue</item>
        <item name="rippleColor">@color/red</item>
    </style>
    <style name="Theme.Listshop" parent="Base.Theme.Listshop" />
</resources>